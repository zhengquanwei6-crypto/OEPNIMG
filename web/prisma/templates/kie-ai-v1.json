{
  "id": "kie-ai-v1",
  "name": "KIE.AI 图像生成",
  "baseUrl": "https://api.kie.ai/api/v1",
  "version": "1.0.0",
  "auth": {
    "type": "bearer",
    "valueTemplate": "Bearer {API_KEY}"
  },
  "capabilities": ["text-to-image", "image-to-image"],
  "models": [
    {
      "id": "flux-kontext-pro",
      "displayName": "Flux Kontext Pro",
      "capability": "text-to-image",
      "endpoint": { "method": "POST", "path": "/flux/kontext/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "aspectRatio": "{{aspectRatio|1:1}}",
          "model": "flux-kontext-pro",
          "outputFormat": "{{outputFormat|jpeg}}",
          "enableTranslation": true,
          "promptUpsampling": false
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/flux/kontext/record-info?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 300000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultImageUrl"
        }
      }
    },
    {
      "id": "flux-kontext-max",
      "displayName": "Flux Kontext Max",
      "capability": "text-to-image",
      "endpoint": { "method": "POST", "path": "/flux/kontext/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "aspectRatio": "{{aspectRatio|1:1}}",
          "model": "flux-kontext-max",
          "outputFormat": "{{outputFormat|jpeg}}",
          "enableTranslation": true,
          "promptUpsampling": false
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/flux/kontext/record-info?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 600000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultImageUrl"
        }
      }
    },
    {
      "id": "flux-kontext-edit",
      "displayName": "Flux Kontext (图生图)",
      "capability": "image-to-image",
      "endpoint": { "method": "POST", "path": "/flux/kontext/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "inputImage": "{{imageUrl}}",
          "aspectRatio": "{{aspectRatio|1:1}}",
          "model": "flux-kontext-pro",
          "outputFormat": "{{outputFormat|jpeg}}",
          "enableTranslation": true
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/flux/kontext/record-info?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 600000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultImageUrl"
        }
      }
    },
    {
      "id": "gpt-4o-image",
      "displayName": "4o Image (GPT-Image-1)",
      "capability": "text-to-image",
      "endpoint": { "method": "POST", "path": "/gpt4o-image/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "size": "{{size|1:1}}",
          "isEnhance": false
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/gpt4o-image/record-info?taskId={{taskId}}" },
          "intervalMs": 5000,
          "timeoutMs": 600000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultUrls[*]"
        }
      }
    }
  ],
  "notes": "kie.ai 任务式 API。Bearer token + JSON body。successFlag: 0=进行中, 1=成功, 2/3=失败。文档: https://docs.kie.ai/"
}
