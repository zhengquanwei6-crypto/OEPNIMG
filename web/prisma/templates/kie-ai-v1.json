{
  "id": "kie-ai-v1",
  "name": "KIE.AI 图像生成",
  "baseUrl": "https://api.kie.ai/api/v1",
  "version": "1.0.0",
  "auth": {
    "type": "bearer",
    "valueTemplate": "Bearer {API_KEY}"
  },
  "capabilities": ["text-to-image", "image-to-image"],
  "models": [
    {
      "id": "gpt-image-2-t2i",
      "displayName": "GPT Image 2 · 文生图",
      "capability": "text-to-image",
      "endpoint": { "method": "POST", "path": "/jobs/createTask" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "model": "gpt-image-2-text-to-image",
          "input": {
            "prompt": "{{prompt}}",
            "aspect_ratio": "{{aspectRatio|auto}}",
            "resolution": "{{resolution|1K}}",
            "output_format": "{{outputFormat|png}}"
          }
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/jobs/recordInfo?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 600000,
          "statusPath": "data.state",
          "doneStatuses": ["success"],
          "failStatuses": ["fail"],
          "imageUrlPath": "data.resultJson>>resultUrls[*]"
        }
      },
      "notes": "分辨率：1K / 2K / 4K（注意 1:1 不能 4K；auto 默认只能 1K）。长宽比：auto / 1:1 / 9:16 / 16:9 / 4:3 / 3:4。"
    },
    {
      "id": "gpt-image-2-i2i",
      "displayName": "GPT Image 2 · 图生图",
      "capability": "image-to-image",
      "endpoint": { "method": "POST", "path": "/jobs/createTask" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "model": "gpt-image-2-image-to-image",
          "input": {
            "prompt": "{{prompt}}",
            "image_input": ["{{imageUrl}}"],
            "aspect_ratio": "{{aspectRatio|auto}}",
            "resolution": "{{resolution|1K}}",
            "output_format": "{{outputFormat|png}}"
          }
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/jobs/recordInfo?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 600000,
          "statusPath": "data.state",
          "doneStatuses": ["success"],
          "failStatuses": ["fail"],
          "imageUrlPath": "data.resultJson>>resultUrls[*]"
        }
      }
    },
    {
      "id": "flux-kontext-pro",
      "displayName": "Flux Kontext Pro",
      "capability": "text-to-image",
      "endpoint": { "method": "POST", "path": "/flux/kontext/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "aspectRatio": "{{aspectRatio|1:1}}",
          "model": "flux-kontext-pro",
          "outputFormat": "{{outputFormat|jpeg}}",
          "enableTranslation": true,
          "promptUpsampling": false
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/flux/kontext/record-info?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 300000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultImageUrl"
        }
      }
    },
    {
      "id": "flux-kontext-max",
      "displayName": "Flux Kontext Max",
      "capability": "text-to-image",
      "endpoint": { "method": "POST", "path": "/flux/kontext/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "aspectRatio": "{{aspectRatio|1:1}}",
          "model": "flux-kontext-max",
          "outputFormat": "{{outputFormat|jpeg}}",
          "enableTranslation": true,
          "promptUpsampling": false
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/flux/kontext/record-info?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 600000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultImageUrl"
        }
      }
    },
    {
      "id": "flux-kontext-edit",
      "displayName": "Flux Kontext · 图生图",
      "capability": "image-to-image",
      "endpoint": { "method": "POST", "path": "/flux/kontext/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "inputImage": "{{imageUrl}}",
          "aspectRatio": "{{aspectRatio|1:1}}",
          "model": "flux-kontext-pro",
          "outputFormat": "{{outputFormat|jpeg}}",
          "enableTranslation": true
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/flux/kontext/record-info?taskId={{taskId}}" },
          "intervalMs": 4000,
          "timeoutMs": 600000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultImageUrl"
        }
      }
    },
    {
      "id": "gpt-4o-image",
      "displayName": "4o Image (GPT-Image-1)",
      "capability": "text-to-image",
      "endpoint": { "method": "POST", "path": "/gpt4o-image/generate" },
      "request": {
        "contentType": "application/json",
        "bodyTemplate": {
          "prompt": "{{prompt}}",
          "size": "{{size|1:1}}",
          "isEnhance": false
        }
      },
      "response": {
        "type": "async-polling",
        "taskIdPath": "data.taskId",
        "errorPath": "msg",
        "polling": {
          "endpoint": { "method": "GET", "path": "/gpt4o-image/record-info?taskId={{taskId}}" },
          "intervalMs": 5000,
          "timeoutMs": 600000,
          "statusPath": "data.successFlag",
          "doneStatuses": ["1"],
          "failStatuses": ["2", "3"],
          "imageUrlPath": "data.response.resultUrls[*]"
        }
      }
    }
  ],
  "notes": "kie.ai 任务式 API。两套端点：1) /jobs/createTask + /jobs/recordInfo （新版统一，state=success/fail/generating）2) /flux/kontext/* + /gpt4o-image/* （旧版，successFlag=0/1/2/3）。GPT Image 2 支持 1K/2K/4K 分辨率与多种长宽比。"
}
