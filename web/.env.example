# ---------- 数据库 ----------
# 开发用 SQLite，生产可换 PostgreSQL： postgresql://user:pass@host:5432/oepnimg
DATABASE_URL="file:./dev.db"

# ---------- 应用密钥 ----------
# 至少 32 字节，用于 cookie 加密 & API Key 字段加密
SESSION_SECRET="please-change-me-please-change-me-32+chars"
MASTER_KEY="please-change-me-32-bytes-base64-or-hex-here"

# ---------- 默认管理员（首次启动时若库为空则种入） ----------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234"

# ---------- LLM 助手（自举：走任意 OpenAI 兼容中转站） ----------
AGENT_BASE_URL="https://api.openai.com/v1"
AGENT_API_KEY=""
AGENT_MODEL="gpt-4o-mini"

# ---------- 文档抓取 ----------
FETCH_TIMEOUT_MS="20000"
FETCH_MAX_BYTES="2000000"
