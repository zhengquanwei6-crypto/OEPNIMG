{
  "name": "oepnimg-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "OEPNIMG 移动端壳工程（Capacitor + Android 原生）",
  "scripts": {
    "build:web": "pnpm -C ../web build && pnpm -C ../web exec next export || true",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "open:android": "cap open android",
    "run:android": "cap run android",
    "build:android:xiaomi": "cd android && ./gradlew assembleXiaomiRelease",
    "build:android:oppo": "cd android && ./gradlew assembleOppoRelease",
    "build:android:universal": "cd android && ./gradlew assembleUniversalRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/toast": "^6.0.2"
  }
}
